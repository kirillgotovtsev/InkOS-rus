# Пример конфигурации окружения InkOS-rus.
# Скопируйте в .env и задайте собственные значения.

# Протокол поставщика: openai, anthropic или custom.
INKOS_LLM_PROVIDER=openai

# Базовый URL API, например OpenAI-совместимый адрес.
INKOS_LLM_BASE_URL=https://api.openai.com/v1

# Ключ API: вместо примера нужен собственный ключ.
INKOS_LLM_API_KEY=sk-your-key-here

# Идентификатор модели.
INKOS_LLM_MODEL=gpt-4o

# Язык романов по умолчанию.
INKOS_DEFAULT_LANGUAGE=ru

# Необязательные каналы уведомлений.
INKOS_TELEGRAM_BOT_TOKEN=
INKOS_TELEGRAM_CHAT_ID=
INKOS_FEISHU_WEBHOOK_URL=
INKOS_WECOM_WEBHOOK_URL=
